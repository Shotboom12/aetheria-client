# Generate an adapted translation unit. Never modify the external CascLib checkout.
if(WIN32)
    file(READ "${WOWDECOMP_CASCLIB_SOURCE_DIR}/src/CascFiles.cpp" casc_files)
    string(PREPEND casc_files "#define WIN32_LEAN_AND_MEAN\n#define NOMINMAX\n#include \"Engine/Source/Retail/CdnRange.h\"\n")
    file(READ "${CMAKE_SOURCE_DIR}/Engine/Source/Retail/CascRangeFetch.inc" range_helper)
    set(range_marker "DWORD FetchCascFile(TCascStorage * hs, CPATH_TYPE PathType, LPBYTE pbEKey, LPCTSTR szExtension, CASC_PATH<TCHAR> & LocalPath, PCASC_ARCHIVE_INFO pArchiveInfo)")
    string(FIND "${casc_files}" "${range_marker}" marker_at)
    if(marker_at LESS 0)
        message(FATAL_ERROR "Pinned CascLib range hook no longer matches; review the dependency update")
    endif()
    string(REPLACE "${range_marker}" "${range_helper}\n${range_marker}" casc_files "${casc_files}")
    set(range_call_marker "            // Fill-in the archive info")
    string(FIND "${casc_files}" "${range_call_marker}" marker_at)
    if(marker_at LESS 0)
        message(FATAL_ERROR "Pinned CascLib archive range call no longer matches")
    endif()
    string(REPLACE "${range_call_marker}" "            return FetchCascAssetRange(hs, pbEKey, pEKeyEntry, LocalPath, pArchiveInfo);\n${range_call_marker}" casc_files "${casc_files}")
    file(WRITE "${CMAKE_BINARY_DIR}/CascFiles-ranged.cpp" "${casc_files}")
    get_target_property(casc_sources casc_static SOURCES)
    list(FILTER casc_sources EXCLUDE REGEX "(^|/)CascFiles\\.cpp$")
    set_property(TARGET casc_static PROPERTY SOURCES "${casc_sources}")
    target_sources(casc_static PRIVATE "${CMAKE_BINARY_DIR}/CascFiles-ranged.cpp")
    target_include_directories(casc_static PRIVATE "${CMAKE_SOURCE_DIR}")
    set_property(TARGET casc_static APPEND PROPERTY INTERFACE_LINK_LIBRARIES winhttp)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${CMAKE_SOURCE_DIR}/Engine/Source/Retail/CascRangeFetch.inc")
endif()
