layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D reactiveMask;
layout(binding=1) uniform sampler2D compositionMask;
layout(binding=2,rgba8) writeonly uniform image2D outputImage;
layout(push_constant) uniform Push {float scale;float threshold;uint view;uint pad;} pc;
void main(){ivec2 p=ivec2(gl_GlobalInvocationID.xy),size=imageSize(outputImage);if(any(greaterThanEqual(p,size)))return;
 ivec2 src=textureSize(reactiveMask,0);ivec2 q=min(ivec2((vec2(p)+.5)*vec2(src)/vec2(size)),src-1);
 float v=pc.view==2?texelFetch(reactiveMask,q,0).r:texelFetch(compositionMask,q,0).r;imageStore(outputImage,p,vec4(v,v,v,1));}
