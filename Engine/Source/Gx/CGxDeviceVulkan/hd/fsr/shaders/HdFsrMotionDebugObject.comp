// Diagnostic (HD, 2026-10-31): which pixels carry an OBJECT motion marker (M2), at any distance.
// Unmarked (camera motion) = dark grey; marked and still = cyan; marked and moving = red -> yellow with amplitude.
#version 450
layout(local_size_x=8,local_size_y=8)in;
layout(rgba16f,binding=0)uniform readonly image2D objectMotion;
layout(rgba8,binding=1)uniform writeonly image2D debugImage;
layout(push_constant)uniform Push{vec4 settings;}c;
void main(){
 ivec2 p=ivec2(gl_GlobalInvocationID.xy),size=imageSize(debugImage);if(any(greaterThanEqual(p,size)))return;
 ivec2 source=min(ivec2((vec2(p)+.5)*vec2(imageSize(objectMotion))/vec2(size)),imageSize(objectMotion)-1);
 vec4 m=imageLoad(objectMotion,source);
 vec3 rgb=vec3(.12);
 if(m.z==1.0&&!any(isnan(m.xy))&&!any(isinf(m.xy))){
  float a=length(m.xy)*c.settings.x;
  rgb=a<.02?vec3(0.,1.,1.):mix(vec3(1.,0.,0.),vec3(1.,1.,0.),clamp(a,0.,1.));
 }
 imageStore(debugImage,p,vec4(rgb,1));
}
