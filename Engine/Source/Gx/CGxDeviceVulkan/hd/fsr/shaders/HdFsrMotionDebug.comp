#version 450
layout(local_size_x=8,local_size_y=8)in;
layout(rg16f,binding=0)uniform readonly image2D motionImage;
layout(rgba8,binding=1)uniform writeonly image2D debugImage;
layout(push_constant)uniform Push{vec4 settings;}c;
void main(){
 ivec2 p=ivec2(gl_GlobalInvocationID.xy),size=imageSize(debugImage);if(any(greaterThanEqual(p,size)))return;
 ivec2 source=min(ivec2((vec2(p)+.5)*vec2(imageSize(motionImage))/vec2(size)),imageSize(motionImage)-1);
 vec2 v=imageLoad(motionImage,source).xy;if(any(isnan(v))||any(isinf(v)))v=vec2(0);
 vec3 rgb=vec3(.5+v*c.settings.x,.5+length(v)*c.settings.x);
 imageStore(debugImage,p,vec4(clamp(rgb,0,1),1));
}
