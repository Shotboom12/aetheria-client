// HD 2026-11-02 (DLSS): sharpening after DLSS, which has none of its own since SDK 310. The same robust contrast
// adaptive sharpening (RCAS) FSR applies after its upscale, with the same strength curve, so hdFSRSharpness means
// the same thing for both up to 1: con = exp2(-(2 - 2 * sharpness)). hdDLSSSharpness goes to 2: above 1, RCAS at
// FSR's maximum and its change pushed further (boost 1..2), clamped to the displayable range.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba8) uniform readonly image2D src;   // DLSS's output (display size, GENERAL)
layout(binding = 1, rgba8) uniform writeonly image2D dst;  // the FSR pass's output, copied onto the back buffer
layout(push_constant) uniform Push { float con; uint width; uint height; float boost; } p;

const float kLimit = 0.25 - 1.0 / 16.0;   // FSR_RCAS_LIMIT

vec4 at(ivec2 c) { return imageLoad(src, clamp(c, ivec2(0), ivec2(int(p.width) - 1, int(p.height) - 1))); }

void main() {
    const ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c.x >= int(p.width) || c.y >= int(p.height)) return;
    //    b
    //  d e f
    //    h
    const vec3 b = at(c + ivec2(0, -1)).rgb, d = at(c + ivec2(-1, 0)).rgb, f = at(c + ivec2(1, 0)).rgb, h = at(c + ivec2(0, 1)).rgb;
    const vec4 e4 = at(c);
    const vec3 e = e4.rgb;
    const vec3 mn4 = min(min(b, d), min(f, h));
    const vec3 mx4 = max(max(b, d), max(f, h));
    // How far the centre may be pushed before a channel clips, the limit FSR uses (no ringing past the neighbours).
    const vec3 hitMin = min(mn4, e) / max(4.0 * mx4, vec3(1e-5));
    const vec3 hitMax = (1.0 - max(mx4, e)) / min(4.0 * mn4 - 4.0, vec3(-1e-5));
    const vec3 lobeRGB = max(-hitMin, hitMax);
    const float lobe = max(-kLimit, min(max(lobeRGB.r, max(lobeRGB.g, lobeRGB.b)), 0.0)) * p.con;
    const vec3 col = (lobe * (b + d + f + h) + e) / (4.0 * lobe + 1.0);
    imageStore(dst, c, vec4(clamp(e + p.boost * (col - e), 0.0, 1.0), e4.a));
}
