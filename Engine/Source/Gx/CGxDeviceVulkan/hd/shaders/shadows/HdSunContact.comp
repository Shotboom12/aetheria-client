#version 450
#extension GL_GOOGLE_include_directive : require
#include "HdSunCommon.glsl"
void main(){ivec2 px=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(px,imageSize(contactTarget))))return;
 float z=linearDepth(px),v=1;
 if(z>0&&pc.flags.w!=0u){vec2 uv=(vec2(px)+.5)*c.screen.xy;vec3 p=pointAt(uv,z),n=normalAt(px,p),L=normalize(c.sun.xyz);
  vec3 a=p+n*c.settings.y+L*c.contact.y,b=a+L*c.sun.w;
  if(a.z>0&&b.z>0){vec2 from=project(a),to=project(b),span=(to-from)/c.screen.xy;int steps=clamp(int(ceil(max(abs(span.x),abs(span.y)))),1,64);
   float prev=-c.contact.y;
   for(int i=1;i<=steps;++i){float t=float(i)/steps;vec2 at=mix(from,to,t);if(any(lessThan(at,c.rect.xy))||any(greaterThan(at,c.rect.xy+1/c.rect.zw)))break;
    float rayZ=1/mix(1/a.z,1/b.z,t);ivec2 sp=ivec2(at/c.screen.xy);float surface=linearDepth(sp);float delta=rayZ-surface;
    float prevZ=1/mix(1/a.z,1/b.z,float(i-1)/steps);
    if(surface>0&&delta>=0&&delta<c.contact.x+abs(prevZ-rayZ)){v=mix(1.0,smoothstep(.85,1.0,t),c.contact.z);break;}prev=surface>0?delta:-c.contact.y;
   }
  }
 }
 float sun=1;if(z>0){vec2 uv=(vec2(px)+.5)*c.screen.xy;vec4 lo=texelFetch(lowEndpoint,px,0),hi=texelFetch(highEndpoint,px,0);
  // HD: the grass takes the sun of the ground behind it, so it fades into the ground's shadow
  if(overRecord(px,lo,hi,z)){vec4 nr=texelFetch(sceneNormal,px,0);vec3 n=dot(nr.xyz,nr.xyz)>.25?normalize(nr.xyz):vec3(0,0,-1);v=1;sun=visibility(pointAt(uv,recordDepth(px))+n*c.settings.y,lo.a<0);}
  // (moved a yard towards the sun, out of its own tuft's shadow)
  else if(looseGrass(px,lo,hi,z)){v=1;sun=visibility(pointAt(uv,z)+normalize(c.sun.xyz),false);}
  else{vec3 p=pointAt(uv,z),n=normalAt(px,p);sun=visibility(p+n*c.settings.y,lo.a<0);}}
 imageStore(contactTarget,px,vec4(v,sun,sun,1));}
