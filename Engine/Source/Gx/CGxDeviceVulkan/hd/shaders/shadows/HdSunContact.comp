#version 450
#extension GL_GOOGLE_include_directive : require
#include "HdSunCommon.glsl"
// HD (HD) OPT5, 4 nov 2026: same image, less work. (1) Grass pixels take v=1 below, so their contact ray is not
// marched. (2) A facet fully turned away from the sun ends at the back-face value, which is never above a marched
// result (that result is mix(1,s,strength) with s>=0, so >= 1-strength), so the march is skipped there too.
// (3) The own-plane test is only worked out for a sample that would otherwise be a hit.
void main(){ivec2 px=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(px,imageSize(contactTarget))))return;
 float z=linearDepth(px),v=1;
 vec4 lo=vec4(0),hi=vec4(0);bool over=false,loose=false;
 if(z>0){lo=texelFetch(lowEndpoint,px,0);hi=texelFetch(highEndpoint,px,0);over=overRecord(px,lo,hi,z);loose=!over&&looseGrass(px,lo,hi,z);}
 if(z>0&&pc.flags.w!=0u&&!over&&!loose){vec2 uv=(vec2(px)+.5)*c.screen.xy;vec3 p=pointAt(uv,z),n=normalAt(px,p),L=normalize(c.sun.xyz);
  // HD (HD) O1: a facet that turns its back to the sun is in its own shadow, whatever the depth noise says. The ray test
  // only caught it 60-90 % of the time past 100 yd and flickered with the FSR jitter (the waves); the own-plane rule below
  // would have removed it altogether. Decided from the geometric normal, with a soft edge around the terminator.
  bool backFace=false,fullBack=false;float back=1;
  if(c.extra.y>.5){vec3 ng=geometricNormal(px,p);if(dot(ng,ng)>.25){float t=clamp((.10-dot(ng,L))/.20,0.0,1.0);back=1.0-t*t*(3.0-2.0*t)*c.contact.z;backFace=true;fullBack=t>=1.0;}}
  vec3 a=p+n*c.settings.y+L*c.contact.y,b=a+L*c.sun.w;
  if(!fullBack&&a.z>0&&b.z>0){vec2 from=project(a),to=project(b),span=(to-from)/c.screen.xy;int steps=clamp(int(ceil(max(abs(span.x),abs(span.y)))),1,64);
   for(int i=1;i<=steps;++i){float t=float(i)/steps;vec2 at=mix(from,to,t);if(any(lessThan(at,c.rect.xy))||any(greaterThan(at,c.rect.xy+1/c.rect.zw)))break;
    float rayZ=1/mix(1/a.z,1/b.z,t);ivec2 sp=ivec2(at/c.screen.xy);float surface=linearDepth(sp);float delta=rayZ-surface;
    float prevZ=1/mix(1/a.z,1/b.z,float(i-1)/steps);
    if(surface>0&&delta>=0&&delta<c.contact.x+abs(prevZ-rayZ)){
     // HD (HD) O1: a sample lying on the receiver's own plane (within D32 steps, a 0.2 % depth margin and
     // 1.7 degrees of normal error along the ray) is the receiver itself, not an occluder. Far away a pixel and a
     // D32 step are wider than the 5 cm start offset, and the surface read at the pixel centre came out in front
     // of the ray: false shadow in waves that followed the camera and the jitter.
     float nd=dot(pointAt((vec2(sp)+.5)*c.screen.xy,1),n),own=abs(nd)>1e-6?dot(p,n)/nd:-1;
     bool ownPlane=c.extra.y>.5&&own>0&&abs(surface-own)<=2*depthStep(surface)+.002*surface+.03*t*c.sun.w;
     if(!ownPlane){v=mix(1.0,smoothstep(.85,1.0,t),c.contact.z);break;}}
   }
  }
  if(backFace)v=min(v,back);
 }
 float sun=1;if(z>0){vec2 uv=(vec2(px)+.5)*c.screen.xy;
  // HD: the grass takes the sun of the ground behind it, so it fades into the ground's shadow
  if(over){vec4 nr=texelFetch(sceneNormal,px,0);vec3 n=dot(nr.xyz,nr.xyz)>.25?normalize(nr.xyz):vec3(0,0,-1);v=1;float rz=recordDepth(px);sun=visibility(pointAt(uv,rz)+n*c.settings.y,lo.a<0,n,rz);}
  // (moved a yard towards the sun, out of its own tuft's shadow)
  else if(loose){v=1;sun=visibility(pointAt(uv,z)+normalize(c.sun.xyz),false,vec3(0),z);}
  else{vec3 p=pointAt(uv,z),n=normalAt(px,p);sun=visibility(p+n*c.settings.y,lo.a<0,n,z);}}
 imageStore(contactTarget,px,vec4(v,sun,sun,1));}
