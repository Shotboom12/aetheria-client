+    return (this->m_obj->m_type & TYPEMASK_PLAYER) && this->m_unit->m_unitFieldBytes0[0] == 61 &&
+        this->m_unit->m_unitFieldDisplayid == this->m_unit->m_unitFieldNativedisplayid &&
+        !this->IsMounted() && !(this->m_vehiclePassenger && this->m_vehiclePassenger->m_state) &&
+        body && (!model || model == body) && body->IsLoaded(0, 0);
+}
+
+void CGUnit_C::UpdateVenthyrHoverAnimation() {
+    if (!this->UsesNativeVenthyrHoverModel()) {
+        if (this->m_venthyrHoverTransition) this->m_animationState &= ~0x40000u;
+        this->m_venthyrHoverTransition = 0;
+        this->m_venthyrHoverWasActive = false;
+        return;
+    }
+    const bool hovering = this->HasAuraBySpellId(111207);
+    const bool blocked = this->IsDeadOrAttachmentDying() || (this->m_unit->m_unitFieldFlags & 0x40000) ||
+        this->m_unit->m_unitChannelSpell || (this->m_animationState & 0x400);
+    if (hovering != this->m_venthyrHoverWasActive) {
+        this->m_venthyrHoverWasActive = hovering;
+        if (this->m_venthyrHoverTransition) this->m_animationState &= ~0x40000u;
+        this->m_venthyrHoverTransition = 0;
+        const uint32_t transition = hovering ? ANIM_LIFT_OFF : ANIM_LAND;
+        if (!blocked && this->GetObjectModel()->HasSequence(transition)) {
+            this->m_venthyrHoverTransition = transition;
+            this->m_venthyrHoverTransitionStart = OsGetAsyncTimeMs();
+            // Animation only: the server retains ground movement and collision.
+            this->PlayBaseAnimation(transition, 0x4);
+            if (this->GetCurrentBaseAnimId() != transition) this->m_venthyrHoverTransition = 0;
+        }
+    }
+    if (!this->m_venthyrHoverTransition) return;
+    M2BoneSequenceInfo sequence = {};
+    const bool completed = this->GetObjectModel()->GetBoneSequenceInfo(0xFFFFFFFF, sequence) &&
+        sequence.m_sequenceId == this->m_venthyrHoverTransition && (sequence.m_finished || sequence.m_complete);
+    if (blocked || completed || OsGetAsyncTimeMs() - this->m_venthyrHoverTransitionStart > 1000) {
+        this->m_venthyrHoverTransition = 0;
+        this->m_animationState &= ~0x40000u;
+        this->m_animationState |= 0x70;
+        this->UpdateBaseAnimation(0, -1);
+    }
+}
